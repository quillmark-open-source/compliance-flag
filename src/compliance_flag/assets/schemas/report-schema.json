{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compliance Flag Audit Report",
  "description": "Schema for SEC Marketing Rule review reports generated by Compliance Flag.",
  "type": "object",
  "required": ["report"],
  "additionalProperties": false,
  "properties": {
    "report": {
      "type": "object",
      "required": ["id", "generated_at", "scanner_version", "generator", "firm", "scan", "summary", "executive_summary", "disclaimer", "findings"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for the report."
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when the report was generated."
        },
        "scanner_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:\\.post\\d+)?$",
          "description": "Package version of the scanner that produced the report."
        },
        "generator": {
          "type": "object",
          "required": ["name", "kind", "version", "website"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Name of the software that generated the report."
            },
            "kind": {
              "type": "string",
              "enum": ["CLI"],
              "description": "Interface used to generate the report."
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+(?:\\.post\\d+)?$",
              "description": "Version of the generator."
            },
            "website": {
              "type": "string",
              "format": "uri",
              "description": "Public website for the report generator."
            }
          }
        },
        "firm": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Registered name of the investment adviser firm."
            },
            "sec_file_number": {
              "type": "string",
              "description": "SEC investment adviser file number (e.g., 801-XXXXX)."
            }
          }
        },
        "scan": {
          "type": "object",
          "required": ["started_at", "completed_at", "source"],
          "additionalProperties": false,
          "properties": {
            "started_at": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 timestamp when the scan began."
            },
            "completed_at": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 timestamp when the scan finished."
            },
            "source": {
              "type": "object",
              "required": ["type", "location", "page_title"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["web", "file", "slack", "gmail", "box", "sql"],
                  "description": "Type of source scanned."
                },
                "location": {
                  "type": "string",
                  "description": "Identifier for the source — URL, file path, channel name, mailbox, etc."
                },
                "page_title": {
                  "type": "string",
                  "description": "The title tag of the scanned page."
                }
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "required": ["total_findings", "by_severity", "by_category"],
          "additionalProperties": false,
          "properties": {
            "total_findings": {
              "type": "integer",
              "minimum": 0,
              "description": "Total number of findings in the report."
            },
            "by_severity": {
              "type": "object",
              "required": ["critical", "high", "medium", "low"],
              "additionalProperties": false,
              "properties": {
                "critical": { "type": "integer", "minimum": 0 },
                "high": { "type": "integer", "minimum": 0 },
                "medium": { "type": "integer", "minimum": 0 },
                "low": { "type": "integer", "minimum": 0 }
              }
            },
            "by_category": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 },
              "description": "Finding counts keyed by category from the taxonomy."
            }
          }
        },
        "executive_summary": {
          "type": "string",
          "description": "A narrative executive summary of the overall compliance posture. Covers the most critical risks, recurring patterns across findings, the regulatory exposure level, and prioritized remediation recommendations. Written for a CCO or senior compliance audience."
        },
        "disclaimer": {
          "type": "object",
          "required": ["product", "website", "text"],
          "additionalProperties": false,
          "properties": {
            "product": {
              "type": "string",
              "description": "Name of the product that generated the report."
            },
            "website": {
              "type": "string",
              "format": "uri",
              "description": "Public website for the product that generated the report."
            },
            "text": {
              "type": "string",
              "description": "Reviewer-facing disclaimer for report use and limitations."
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "severity", "category", "rule", "source", "content", "violation"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for the finding."
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"],
          "description": "Severity level of the finding."
        },
        "category": {
          "type": "string",
          "enum": [
            "general_prohibitions",
            "performance_advertising",
            "testimonial_endorsement",
            "third_party_rating",
            "recordkeeping",
            "form_adv"
          ],
          "description": "Regulatory category from the compliance taxonomy."
        },
        "rule": {
          "type": "object",
          "required": ["authority", "citation", "rule_name", "description"],
          "additionalProperties": false,
          "properties": {
            "authority": {
              "type": "string",
              "enum": ["SEC"],
              "description": "Regulatory body that issued the rule."
            },
            "citation": {
              "type": "string",
              "description": "Formal rule citation (e.g., '§ 275.206(4)-1(d)(1)')."
            },
            "rule_name": {
              "type": "string",
              "description": "Human-readable name of the rule."
            },
            "description": {
              "type": "string",
              "description": "Brief description of what the rule requires."
            }
          }
        },
        "related_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["authority", "citation"],
            "additionalProperties": false,
            "properties": {
              "authority": {
                "type": "string",
                "enum": ["SEC"]
              },
              "citation": {
                "type": "string"
              },
              "rule_name": {
                "type": "string"
              }
            }
          },
          "description": "Other rules that apply to the same concern. Primary rule goes in 'rule'; secondary citations go here."
        },
        "source": {
          "type": "object",
          "required": ["type", "location", "accessed_at"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["web", "file", "slack", "gmail", "box", "sql"],
              "description": "Type of source where the content was found."
            },
            "location": {
              "type": "string",
              "description": "Where the content was found — URL, file path, channel/thread, mailbox/subject, etc."
            },
            "accessed_at": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 timestamp when the content was accessed."
            }
          }
        },
        "content": {
          "type": "object",
          "required": ["excerpt"],
          "additionalProperties": false,
          "properties": {
            "excerpt": {
              "type": "string",
              "description": "The specific text or content that triggered the finding."
            },
            "context": {
              "type": "string",
              "description": "Surrounding content for additional context."
            }
          }
        },
        "violation": {
          "type": "object",
          "required": ["explanation", "remediation"],
          "additionalProperties": false,
          "properties": {
            "explanation": {
              "type": "string",
              "description": "Plain-language explanation of why this content may present a compliance concern under the rule."
            },
            "remediation": {
              "type": "object",
              "required": ["summary", "steps"],
              "additionalProperties": false,
              "properties": {
                "summary": {
                  "type": "string",
                  "description": "Brief overview of the recommended remediation approach."
                },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  },
                  "description": "Specific actionable remediation steps. These are rendered as a numbered list in HTML reports."
                },
                "suggested_language": {
                  "type": "string",
                  "description": "Optional suggested replacement or disclosure language where appropriate."
                }
              },
              "description": "Structured remediation recommendations for the finding."
            }
          }
        }
      }
    }
  }
}
